<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="x-apple-disable-message-reformatting" />
  <title>Raz Technologies — Verification Code</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { margin: 0; padding: 0; background-color: #f1f5f9; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    img { border: 0; display: block; }
    a { text-decoration: none; }

    /* OTP digit boxes — static, no dynamic styles needed */
    .otp-row {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin: 0 auto;
    }
    .otp-digit {
      width: 48px;
      height: 58px;
      background: #ffffff;
      border: 2px solid #93c5fd;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      font-weight: 800;
      color: #0d1a42;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
    }

    @media only screen and (max-width: 600px) {
      .email-wrapper  { padding: 16px !important; }
      .email-card     { border-radius: 16px !important; }
      .card-body      { padding: 28px 20px !important; }
      .otp-digit      { width: 40px !important; height: 50px !important; font-size: 22px !important; }
      .otp-row        { gap: 6px !important; }
    }
  </style>
</head>

<body style="margin:0;padding:0;background-color:#f1f5f9;font-family:'Segoe UI',Helvetica,Arial,sans-serif;">

  <%# Hidden preheader text — shown in inbox preview %>
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;color:#f1f5f9;">
    Your Raz Technologies verification code — do not share this with anyone.
    &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
  </div>

  <%# ── OUTER WRAPPER ── %>
  <div class="email-wrapper" style="width:100%;padding:32px 16px;">
    <div style="max-width:600px;margin:0 auto;">

      <%# ── EMAIL CARD ── %>
      <div class="email-card" style="background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 4px 24px rgba(13,26,66,0.10);">

        <%# ── HEADER BANNER ── %>
        <div style="background:linear-gradient(135deg,#0d1a42 0%,#1660eb 100%);padding:36px 40px;text-align:center;">
          <div style="width:56px;height:56px;background:rgba(255,255,255,0.15);border-radius:14px;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;">
            <span style="font-size:28px;line-height:1;">⚡</span>
          </div>
          <p style="font-size:22px;font-weight:800;color:#ffffff;letter-spacing:-0.5px;margin:0 0 4px;">Technologies</p>
          <p style="font-size:11px;color:rgba(255,255,255,0.55);font-weight:500;text-transform:uppercase;letter-spacing:2.5px;margin:0;">Raz Technologies</p>
        </div>

        <%# ── BODY ── %>
        <div class="card-body" style="padding:40px 40px 32px;">

          <%# Label %>
          <p style="font-size:12px;font-weight:700;color:#1660eb;text-transform:uppercase;letter-spacing:2px;margin:0 0 10px;">
            Password Verification
          </p>

          <%# Greeting %>
          <h1 style="font-size:26px;font-weight:700;color:#0d1a42;line-height:1.25;margin:0 0 16px;">
            Hi <%= emailExists.FirstName %>,
          </h1>

          <p style="font-size:15px;color:#475569;line-height:1.75;margin:0 0 28px;">
            We received a request to reset the password for your
            <strong style="color:#0d1a42;">Raz Technologies</strong> account linked to
            <strong style="color:#0d1a42;"><%= emailExists.Email %></strong>.
            Use the 6-digit verification code below to complete the process.
          </p>

          <%# ── OTP BOX ── %>
          <div style="background:linear-gradient(135deg,#eef6ff,#dbeafe);border:1.5px solid #bfdbfe;border-radius:16px;padding:32px 24px;text-align:center;margin-bottom:28px;">

            <p style="font-size:11px;font-weight:700;color:#2563eb;text-transform:uppercase;letter-spacing:2.5px;margin:0 0 20px;">
              Your Verification Code
            </p>
            <%
              var rawCode  = String(recovery.RecoveryCode).replace(/\D/g, '');
              var codeStr  = rawCode.slice(0, 6).padStart(6, '0');
              var digits   = codeStr.split('');
            %>

            <div class="otp-row">
              <% digits.forEach(function(d) { %>
                <div class="otp-digit"><%= d %></div>
              <% }); %>
            </div>

            <%# Plain-text fallback (visible in clients that strip CSS / flex) %>
            <p style="font-size:13px;color:#94a3b8;margin:10px 0 0;">
              Code: <strong style="font-size:22px;letter-spacing:6px;color:#0d1a42;font-family:monospace;"><%= codeStr %></strong>
            </p>

            <%# Expiry %>
            <p style="font-size:13px;color:#64748b;margin:16px 0 0;">
              ⏱&nbsp;Expires in <strong style="color:#0d1a42;">1 hour</strong>
              &nbsp;&mdash;&nbsp;
              <%
                var expiryTime = new Date(recovery.Expiry).toLocaleTimeString('en-KE', {
                  hour:     '2-digit',
                  minute:   '2-digit',
                  timeZone: 'Africa/Nairobi'
                });
              %>
              at <strong style="color:#0d1a42;"><%= expiryTime %> EAT</strong>
            </p>

          </div>
          <%# /OTP BOX %>

          <%# ── SECURITY WARNING ── %>
          <div style="background:#fff7ed;border:1.5px solid #fed7aa;border-radius:12px;padding:16px 20px;margin-bottom:28px;">
            <div style="display:flex;align-items:flex-start;gap:10px;">
              <span style="font-size:16px;flex-shrink:0;">⚠️</span>
              <div>
                <p style="font-size:13px;font-weight:700;color:#9a3412;margin:0 0 4px;">Keep this code private</p>
                <p style="font-size:13px;color:#c2410c;margin:0;line-height:1.6;">
                  Raz Technologies will <strong>never</strong> ask for this code via phone, chat, or email.
                  If you did not request a password reset, please ignore this email or
                  <a href="mailto:support@raztechnologies.co.ke" style="color:#9a3412;text-decoration:underline;font-weight:600;">contact support</a> immediately.
                </p>
              </div>
            </div>
          </div>

          <%# ── STEPS ── %>
          <p style="font-size:15px;color:#475569;line-height:1.75;margin:0 0 8px;">
            To complete your password reset:
          </p>
          <div style="margin:0 0 28px;padding-left:4px;">
            <div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:10px;">
              <div style="width:22px;height:22px;background:#1660eb;border-radius:50%;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">1</div>
              <p style="font-size:14px;color:#475569;margin:0;line-height:1.6;">Return to the Raz Technologies password reset page.</p>
            </div>
            <div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:10px;">
              <div style="width:22px;height:22px;background:#1660eb;border-radius:50%;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">2</div>
              <p style="font-size:14px;color:#475569;margin:0;line-height:1.6;">Enter the 6-digit code in the verification field.</p>
            </div>
            <div style="display:flex;align-items:flex-start;gap:12px;">
              <div style="width:22px;height:22px;background:#1660eb;border-radius:50%;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;">3</div>
              <p style="font-size:14px;color:#475569;margin:0;line-height:1.6;">Choose and confirm your new password.</p>
            </div>
          </div>

          <p style="font-size:14px;color:#94a3b8;line-height:1.75;margin:0;">
            Questions? <a href="mailto:support@raztechnologies.co.ke" style="color:#1660eb;font-weight:600;text-decoration:underline;">Contact our support team</a> and we'll help right away.
          </p>

        </div>
        <%# /BODY %>

        <%# ── DIVIDER ── %>
        <div style="height:1px;background:#e2e8f0;margin:0 40px;"></div>

        <%# ── FOOTER ── %>
        <div style="padding:28px 40px 36px;text-align:center;">

          <div style="display:inline-block;background:#f8fafc;border:1px solid #e2e8f0;border-radius:100px;padding:8px 20px;margin-bottom:20px;">
            <p style="font-size:12px;color:#64748b;margin:0;">
              Sent to <strong style="color:#0d1a42;"><%= emailExists.Email %></strong>
            </p>
          </div>

          <p style="font-size:12px;color:#94a3b8;margin:0 0 8px;">
            <a href="https://raztechnologies.co.ke" style="color:#64748b;font-weight:500;">Home</a>
            &nbsp;&bull;&nbsp;
            <a href="https://raztechnologies.co.ke/#contact" style="color:#64748b;font-weight:500;">Support</a>
            &nbsp;&bull;&nbsp;
            <a href="https://raztechnologies.co.ke/privacy" style="color:#64748b;font-weight:500;">Privacy Policy</a>
          </p>

          <p style="font-size:12px;color:#cbd5e1;margin:0 0 4px;">
            &copy; <%= new Date().getFullYear() %> Raz Technologies. All rights reserved.
          </p>
          <p style="font-size:12px;color:#cbd5e1;margin:0;">
            Eldoret, Kenya &mdash; Serving All Counties
          </p>

        </div>
        <%# /FOOTER %>

      </div>
      <%# /EMAIL CARD %>

    </div>
  </div>
  <%# /OUTER WRAPPER %>

</body>
</html>
